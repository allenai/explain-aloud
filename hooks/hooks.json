{
  "modules": ["./register.tsx"],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/explain.py\" --hook || python \"${CLAUDE_PLUGIN_ROOT}/scripts/explain.py\" --hook",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/explain.py\" --cancel || python \"${CLAUDE_PLUGIN_ROOT}/scripts/explain.py\" --cancel",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
